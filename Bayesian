#Análisis Bayesiano para Suicidio y Semaglutida



# Install required packages
install.packages(c("openxlsx", "brms"))

# Load libraries
library(openxlsx)
library(brms)

# Read data
Datos <- read.xlsx("SemaglutidaSuicidio.xlsx")

# Reshape data to long format
Datos_long <- data.frame(
  Author = rep(Datos$Author, each = 2),
  group  = rep(c("Intervention", "Control"), times = nrow(Datos)),
  events = c(Datos$event.e, Datos$event.c),
  time   = c(Datos$time.e, Datos$time.c)
)

# Create treatment indicator
Datos_long$treat <- ifelse(Datos_long$group == "Intervention", 1, 0)

# Define priors
priors <- c(
  brms::prior(normal(0, 1), class = "Intercept"),
  brms::prior(normal(0, 1), class = "b"),
  brms::prior(cauchy(0, 0.5), class = "sd")
)

# Bayesian Poisson meta-regression with random study effects
m.bmrs <- brm(
  events ~ treat + offset(log(time)) + (1 | Author),
  data = Datos_long,
  family = poisson(),
  prior = priors,
  chains = 4,
  iter = 4000,
  warmup = 1000,
  control = list(adapt_delta = 0.95)
)

# Model summary
summary(m.bmrs)

# Posterior predictive checks
pp_check(m.bmrs)

# Extract Incidence Rate Ratio (IRR)
posterior <- posterior_samples(m.bmrs)
IRR <- exp(posterior$b_treat)

# IRR summary
quantile(IRR, probs = c(0.025, 0.5, 0.975))

